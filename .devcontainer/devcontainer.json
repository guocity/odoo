// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/alpine
{
	"name": "Odoo Python Development",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/git:1": {}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [8069],

	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "pip install uv && uv pip install --system -r requirements.txt || echo 'No requirements.txt found, skipping dependency installation'",
	// add postgres, and libdap
	"postCreateCommand": "apt-get update && apt-get install -y libldap2-dev libsasl2-dev postgresql-client libpq-dev && pip install uv && uv pip install --system -r requirements.txt || echo 'No requirements.txt found, skipping dependency installation'",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"python.linting.enabled": true,
				"editor.formatOnSave": true
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
